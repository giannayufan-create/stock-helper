# ── Nova Pro server providers ────────────────────────────────────────
# Providers default to mock (simulated quotes & paper trading, no
# credentials needed). Switch to real providers once you have keys.
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
MARKET_PROVIDER=mock   # mock | fugle
TRADE_PROVIDER=mock    # mock | fubon | nova
PORT=8787

# ── Fugle market data (MARKET_PROVIDER=fugle) ────────────────────────
# Apply for an API key at https://developer.fugle.tw/
FUGLE_API_KEY=

# ── Shioaji / 永豐行情 ──────────────────────────────────────────────
# Set SHIOAJI_ENABLED=true with both keys to prefer 永豐 over fugle/mock.
SHIOAJI_ENABLED=false
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_BRIDGE_URL=http://127.0.0.1:18080

# ── Broker login (TRADE_PROVIDER=fubon or nova) ──────────────────────
# Both Fubon NEO (fubon-neo) and Taishin Nova (taishin-sdk) log in with
# national ID + password + certificate (.pfx) + certificate password.
# Their SDKs are downloaded manually as .tgz — drop them in server/vendor/.
BROKER_ID_NO=
BROKER_PASSWORD=
BROKER_CERT_PATH=
BROKER_CERT_PASS=

# ── Frontend (optional) ──────────────────────────────────────────────
# Override REST/SSE base URL for a remote server.
# Leave unset when using the dev proxy.
# VITE_API_BASE=http://127.0.0.1:8080

# ── FinMind 券商分點（盤後，約 21:00）──────────────────────────────
# 在 https://finmindtrade.com/ 註冊，個人頁複製 token。
# Render 環境變數：Key 填 FINMIND_KEY，Value 填你的 token（不要把 token 寫進 git）。
# 免費版 600 次/小時。程式預設每小時最多打 480 次，一檔股票 12 小時只打 1 次。
# 分點資料集通常需要 Sponsor；免費額度保護排行不會掃全市場。
FINMIND_KEY=
# FINMIND_MAX_PER_HOUR=480

# ── AI (Gemini coach + optional Python analyzer) ─────────────────────
# Gemini key stays on the Node server — never put it in VITE_*.
GEMINI_API_KEY=
# Local Python FastAPI (analyzer/). Leave empty to use Node local scoring.
# ANALYZER_URL=http://127.0.0.1:8090
ANALYZER_URL=

# ── Research Persistence (Backend only — never VITE_*) ───────────────
# Canonical mode: jsonl | dual | firestore
# Production target: RESEARCH_REPOSITORY_MODE=firestore
RESEARCH_REPOSITORY_MODE=jsonl
# Legacy alias (backward compatible). Prefer RESEARCH_REPOSITORY_MODE.
# RESEARCH_REPOSITORY=jsonl
RESEARCH_PERSISTENCE_QUEUE_MAX=500
RESEARCH_PERSISTENCE_QUEUE_WARN=100
RESEARCH_PERSISTENCE_QUEUE_CRITICAL=400
RESEARCH_HYDRATE_LOOKBACK_DAYS=30
RESEARCH_PAGE_LIMIT=100

# ── Firebase Admin (Backend / Render only — NEVER put in VITE_*) ──────
# Required for dual/firestore. Do not commit real values.
# FIREBASE_PRIVATE_KEY: if Render stores literal \n, backend normalizes once at init.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional ADC fallback (prefer FIREBASE_* on Render):
# GOOGLE_APPLICATION_CREDENTIALS=